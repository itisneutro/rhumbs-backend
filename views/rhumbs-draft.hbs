<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>Добавление румба</title>
  <link rel="stylesheet" href="/css/rhumbs.css">
</head>
<body>
  <main class="rhumbs-screen">
    <h1 class="rhumbs-draft__title">Добавление румба</h1>

    <form class="rhumbs-draft__form"
          method="POST"
          action="{{#if rhumb}}/rhumbs/{{rhumb.id}}/publish{{else}}/rhumbs/draft{{/if}}">
      <div class="rhumbs-draft__media">
        {{> rhumbs_image class="rhumbs-draft__preview" imageUrl=rhumb.imageUrl}}
        {{#unless rhumb}}
        <label class="rhumbs-button rhumbs-button--small">Выбрать<input class="rhumbs-draft__file" type="file" accept="image/*"></label>
        {{/unless}}
      </div>

      <div class="rhumbs-draft__media">
        {{> rhumbs_video class="rhumbs-draft__preview" videoUrl=rhumb.videoUrl}}
        {{#unless rhumb}}
        <label class="rhumbs-button rhumbs-button--small">Выбрать<input class="rhumbs-draft__file" type="file" accept="video/*"></label>
        {{/unless}}
      </div>

      <label class="rhumbs-draft__label" for="rhumbs-name">Название</label>
      <input class="rhumbs-draft__input"
             id="rhumbs-name" type="text" name="name" value="{{rhumb.name}}"
             required maxlength="64">

      {{#if rhumb}}
      <label class="rhumbs-draft__label" for="rhumbs-description">Краткое описание</label>
      <textarea class="rhumbs-draft__area"
                id="rhumbs-description" name="description"
                required maxlength="512">{{rhumb.description}}</textarea>

      <label class="rhumbs-draft__label" for="rhumbs-geographic">Географический азимут</label>
      <input class="rhumbs-draft__input"
             id="rhumbs-geographic" type="number" name="geographicAzimuthDeg"
             value="{{rhumb.geographicAzimuthDeg}}"
             min="0" max="359" step="1" required>

      <label class="rhumbs-draft__label" for="rhumbs-magnetic">Магнитный азимут</label>
      <input class="rhumbs-draft__input"
             id="rhumbs-magnetic" type="number" name="magneticAzimuthDeg"
             value="{{rhumb.magneticAzimuthDeg}}"
             min="0" max="359.9" step="0.1" required>

      <button class="rhumbs-button rhumbs-draft__submit" type="submit">Опубликовать</button>
      {{else}}
      <button class="rhumbs-button rhumbs-draft__submit" type="submit">Далее</button>
      {{/if}}
    </form>

    {{> rhumbs_tab_bar draftActive=true}}
  </main>
</body>
</html>
