<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>Румбы ветра</title>
  <link rel="stylesheet" href="/css/wind-rhumbs.css">
</head>
<body>
  <main class="wind-screen">
    <h1 class="wind-tiles-title">Румбы ветра</h1>

    <form class="wind-filter" method="GET" action="/rhumbs">
      <label class="wind-filter-label" for="minAzimuth">Азимут от</label>
      <input class="wind-filter-range"
             id="minAzimuth"
             type="range"
             name="minAzimuth"
             min="0"
             max="360"
             step="45"
             value="{{minAzimuth}}">
      <span class="wind-filter-value">{{minAzimuth}}°</span>
      <button class="wind-filter-button" type="submit">Найти</button>
    </form>

    <div class="wind-tiles-grid">
      {{#each rhumbs}}
      <div class="wind-tile">
        <a class="wind-tile-link" href="/rhumbs/feed/{{this.id}}">
          {{#if this.imageUrl}}
          <object class="wind-tile-image" data="{{this.imageUrl}}" type="image/jpeg">
            <img class="wind-tile-image" src="{{../defaultImageUrl}}" alt="">
          </object>
          {{else}}
          <img class="wind-tile-image" src="{{../defaultImageUrl}}" alt="">
          {{/if}}
          <span class="wind-tile-name">{{this.name}}</span>
          <span class="wind-tile-likes">
            <svg class="wind-icon-heart" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M12 21C12 21 3.6 15.6 3.6 9.9 3.6 7.1 5.8 5 8.5 5c1.6 0 3 0.8 3.5 2 0.5-1.2 1.9-2 3.5-2 2.7 0 4.9 2.1 4.9 4.9C20.4 15.6 12 21 12 21z" fill="currentColor"/>
            </svg>
            {{this.likesCount}}
          </span>
        </a>
        <form class="wind-tile-remove" method="POST" action="/rhumbs/remove">
          <input type="hidden" name="id" value="{{this.id}}">
          <button class="wind-tile-remove-button" type="submit">Удалить</button>
        </form>
      </div>
      {{else}}
      <p class="wind-tiles-empty">Румбы с таким азимутом не найдены</p>
      {{/each}}
    </div>

    {{> wind_tab_bar tilesActive=true}}
  </main>
</body>
</html>
