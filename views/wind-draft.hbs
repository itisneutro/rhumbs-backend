<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>Черновик румба ветра</title>
  <link rel="stylesheet" href="/css/wind-rhumbs.css">
</head>
<body>
  <main class="wind-screen">
    <form method="POST" action="{{#if rhumb}}/rhumbs/publish{{else}}/rhumbs/draft{{/if}}">
      <label class="wind-draft-label wind-draft-label--video" for="rhumb-video-url">Адрес видео</label>
      <input class="wind-draft-slot wind-draft-slot--video"
             id="rhumb-video-url" type="text" name="videoUrl"
             value="{{rhumb.videoUrl}}" placeholder="видео румба">

      <label class="wind-draft-label wind-draft-label--cover" for="rhumb-image-url">Адрес обложки</label>
      <input class="wind-draft-slot wind-draft-slot--cover"
             id="rhumb-image-url" type="text" name="imageUrl"
             value="{{rhumb.imageUrl}}" placeholder="обложка румба">

      <label class="wind-draft-label wind-draft-label--name" for="rhumb-name">Название</label>
      <input class="wind-draft-input wind-draft-input--name"
             id="rhumb-name" type="text" name="name" value="{{rhumb.name}}">

      <label class="wind-draft-label wind-draft-label--description" for="rhumb-description">Описание</label>
      <textarea class="wind-draft-area"
                id="rhumb-description" name="description">{{rhumb.description}}</textarea>

      <label class="wind-draft-label wind-draft-label--geographic" for="rhumb-geographic-azimuth">Географический азимут, °</label>
      <input class="wind-draft-input wind-draft-input--geographic"
             id="rhumb-geographic-azimuth" type="text" name="rhumbGeographicAzimuthDeg"
             value="{{rhumb.rhumbGeographicAzimuthDeg}}">

      <label class="wind-draft-label wind-draft-label--magnetic" for="rhumb-magnetic-azimuth">Магнитный азимут, °</label>
      <input class="wind-draft-input wind-draft-input--magnetic"
             id="rhumb-magnetic-azimuth" type="text" name="rhumbMagneticAzimuthDeg"
             value="{{rhumb.rhumbMagneticAzimuthDeg}}">

      <button class="wind-draft-submit" type="submit">{{#if rhumb}}Опубликовать{{else}}Далее{{/if}}</button>
    </form>

    {{> wind_tab_bar draftActive=true}}
  </main>
</body>
</html>
