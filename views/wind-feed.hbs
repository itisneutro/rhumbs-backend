<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>{{rhumb.name}} румб ветра</title>
  <link rel="stylesheet" href="/css/wind-rhumbs.css">
</head>
<body>
  <main class="wind-screen">
    <video class="wind-feed-video"
           src="{{rhumb.videoUrl}}"
           poster="{{rhumb.imageUrl}}"
           autoplay muted loop playsinline></video>

    <div class="wind-feed-shade"></div>

    <div class="wind-feed-rail">
      <div class="wind-feed-chips">
        <span class="wind-chip">Географический {{rhumb.rhumbGeographicAzimuthDeg}}°</span>
        <span class="wind-chip">Магнитный {{rhumb.rhumbMagneticAzimuthDeg}}°</span>
      </div>

      <div class="wind-feed-likes">
        <svg class="wind-icon-heart" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
          <path d="M12 21C12 21 3.6 15.6 3.6 9.9 3.6 7.1 5.8 5 8.5 5c1.6 0 3 0.8 3.5 2 0.5-1.2 1.9-2 3.5-2 2.7 0 4.9 2.1 4.9 4.9C20.4 15.6 12 21 12 21z" fill="currentColor"/>
        </svg>
        <span class="wind-feed-likes-count">{{likesCount}}</span>
      </div>

      <a class="wind-feed-next" href="/rhumbs/feed/{{rhumb.id}}?next=true">
        <span class="wind-feed-next-circle">
          <svg class="wind-icon-arrow" viewBox="0 0 24 24" width="29" height="29" aria-hidden="true">
            <path d="M12 4v13m0 0 5-5m-5 5-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="wind-feed-next-label">Далее</span>
      </a>
    </div>

    <div class="wind-feed-info">
      <h1 class="wind-feed-name">{{rhumb.name}}</h1>

      <details class="wind-feed-details">
        <summary class="wind-feed-summary">
          <span class="wind-feed-description">{{rhumb.description}}</span>
        </summary>
      </details>
    </div>

    {{> wind_tab_bar feedActive=true}}
  </main>
</body>
</html>
