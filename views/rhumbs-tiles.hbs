<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>Румбы ветра</title>
  <link rel="stylesheet" href="/css/rhumbs.css">
</head>
<body>
  <main class="rhumbs-screen">
    <h1 class="rhumbs-tiles__title">Румбы ветра</h1>

    <form class="rhumbs-tiles__filter" method="GET" action="/rhumbs">
      <label class="rhumbs-tiles__filter-label" for="minAzimuth">Азимут от</label>
      <input class="rhumbs-tiles__filter-range"
             id="minAzimuth"
             type="range"
             name="minAzimuth"
             min="0"
             max="315"
             step="45"
             value="{{minAzimuth}}">
      <span class="rhumbs-tiles__filter-value">{{minAzimuth}}°</span>
      <button class="rhumbs-button rhumbs-button--small rhumbs-tiles__filter-button" type="submit">Найти</button>
    </form>

    <div class="rhumbs-tiles__grid">
      {{#each rhumbs}}
      <div class="rhumbs-tiles__tile">
        <a class="rhumbs-tiles__link" href="/rhumbs/feed/{{this.id}}">
          {{#> rhumbs_image class="rhumbs-tiles__image" imageUrl=this.imageUrl}}<span class="rhumbs-tiles__name">{{this.name}}</span>{{> rhumbs_rose class="rhumbs-rose--tile rhumbs-rose--dark" geo=this.geographicAzimuthDeg mag=this.magneticAzimuthDeg}}{{/rhumbs_image}}
          <span class="rhumbs-tiles__azimuth"><span class="rhumbs-tiles__azimuth-label">Географический</span> <span class="rhumbs-tiles__azimuth-value">{{this.geographicAzimuthDeg}}°</span></span>
          <span class="rhumbs-tiles__azimuth"><span class="rhumbs-tiles__azimuth-label">Магнитный</span> <span class="rhumbs-tiles__azimuth-value">{{this.magneticAzimuthDeg}}°</span></span>
          <span class="rhumbs-tiles__likes">
            <svg class="rhumbs-tiles__heart" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" stroke-linejoin="round" stroke-linecap="round"/></svg>
            <span class="rhumbs-tiles__likes-count">{{this.likesCount}}</span>
          </span>
        </a>
        <form class="rhumbs-tiles__remove" method="POST" action="/rhumbs/{{this.id}}/delete">
          <button class="rhumbs-button rhumbs-button--small rhumbs-tiles__remove-button" type="submit">Удалить</button>
        </form>
      </div>
      {{else}}
      <p class="rhumbs-tiles__empty">Румбы с таким азимутом не найдены</p>
      {{/each}}
    </div>

    {{> rhumbs_tab_bar tilesActive=true}}
  </main>
</body>
</html>
